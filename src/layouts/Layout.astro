---
import '../styles/global.css';
import { company } from '../data/company';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = company.description, ogImage = '/og-image.jpg' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, company.siteUrl);
const ogImageURL = new URL(ogImage, company.siteUrl);

const sameAs = [company.mapsShareUrl, company.social.instagram, company.social.facebook].filter(
  (url): url is string => Boolean(url)
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: company.listingName,
  alternateName: ['Catering Mak Yo', 'Katering Mak Yo', 'Catering MakYo', 'Katering MakYo'],
  description,
  url: company.siteUrl,
  sameAs,
  telephone: company.phoneE164,
  servesCuisine: company.cuisine,
  foundingDate: String(company.foundedYear),
  image: ogImageURL.toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.address.street,
    addressLocality: company.address.city,
    addressRegion: company.address.province,
    postalCode: company.address.postalCode,
    addressCountry: 'ID',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: company.geo.lat,
    longitude: company.geo.lng,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'Monday',
      'Tuesday',
      'Wednesday',
      'Thursday',
      'Friday',
      'Saturday',
      'Sunday',
    ],
    opens: '00:00',
    closes: '23:59',
  },
  hasMap: company.mapsShareUrl,
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#7C3216" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="id_ID" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a href="#main" class="skip-link">Langsung ke konten utama</a>
    <slot />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
