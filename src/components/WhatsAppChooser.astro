---
import { company } from '../data/company';
import Icon from './ui/Icon.astro';

const fallbackMessage = 'Halo, saya ingin menghubungi Catering Mak Yo.';
---

<dialog
  data-wa-dialog
  aria-labelledby="wa-dialog-title"
  aria-describedby="wa-dialog-description"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl bg-cream p-0 text-ink shadow-soft-lg backdrop:bg-ink/50"
>
  <div class="p-6 sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="font-body text-xs font-bold uppercase tracking-[0.18em] text-terracotta-deep">WhatsApp Catering Mak Yo</p>
        <h2 id="wa-dialog-title" class="mt-2 font-display text-2xl font-semibold">Pilih kontak yang ingin dihubungi</h2>
      </div>
      <form method="dialog">
        <button type="submit" aria-label="Tutup pilihan kontak" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-ink/15 text-ink-soft transition-colors hover:bg-cream-dark hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-deep">
          <Icon name="close" class="h-5 w-5" />
        </button>
      </form>
    </div>
    <p id="wa-dialog-description" class="mt-3 text-sm leading-6 text-ink-soft">Pesan Anda akan diteruskan ke WhatsApp kontak yang dipilih.</p>

    <div class="mt-6 grid gap-3">
      {company.contactPhones.map((contact) => {
        const number = contact.e164.replace(/\D/g, '');
        const fallbackHref = `https://wa.me/${number}?text=${encodeURIComponent(fallbackMessage)}`;

        return (
          <a
            href={fallbackHref}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-choice
            data-wa-number={number}
            class="flex min-h-14 items-center justify-between gap-4 rounded-2xl border border-terracotta/20 bg-white px-5 py-3 font-body font-semibold text-ink transition-colors hover:border-terracotta hover:bg-terracotta/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-deep"
          >
            <span>{contact.name}<span class="mt-0.5 block text-sm font-medium text-ink-soft">{contact.display}</span></span>
            <Icon name="whatsapp" class="h-5 w-5 shrink-0 text-terracotta-deep" />
          </a>
        );
      })}
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-wa-dialog]');
  const choices = dialog?.querySelectorAll<HTMLAnchorElement>('[data-wa-choice]');

  document.querySelectorAll<HTMLAnchorElement>('[data-wa-chooser]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      if (!dialog || !choices) return;

      event.preventDefault();
      const message = trigger.dataset.waMessage ?? 'Halo, saya ingin menghubungi Catering Mak Yo.';

      choices.forEach((choice) => {
        const number = choice.dataset.waNumber;
        if (number) {
          choice.href = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
        }
      });

      dialog.showModal();
    });
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
