---
import Container from './ui/Container.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import { waLink } from '../data/company';
---

<section class="relative overflow-hidden bg-green-deep py-24 sm:py-28">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,var(--color-gold),transparent_60%)] opacity-20" aria-hidden="true"></div>

  <Container class="relative text-center" data-reveal>
    <h2 class="mx-auto max-w-2xl font-display text-3xl font-semibold text-white sm:text-4xl">
      Siap Membuat Acara Anda Istimewa?
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-white/80">
      Hubungi kami sekarang dan biarkan cita rasa rumahan Mak Yo melengkapi momen berharga Anda.
    </p>
    <div class="mt-8">
      <Button
        href={waLink('Halo, saya ingin membuat acara saya istimewa bersama Catering Mak Yo.')}
        target="_blank"
        rel="noopener noreferrer"
        class="!bg-white !text-green-deep hover:!bg-cream"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
        Chat via WhatsApp
      </Button>
    </div>
  </Container>
</section>
