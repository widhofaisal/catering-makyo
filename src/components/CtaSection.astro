---
import Container from './ui/Container.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import { waLink } from '../data/company';
---

<section class="bg-white py-20 sm:py-28">
  <Container>
    <div class="relative grid items-center gap-8 overflow-hidden rounded-[2rem] bg-terracotta-deep px-6 py-10 text-cream shadow-soft-lg sm:rounded-[2.5rem] sm:px-10 sm:py-12 lg:grid-cols-[1fr_auto] lg:gap-12 lg:px-16 lg:py-16">
      <div class="pointer-events-none absolute -right-8 -top-28 hidden font-display text-[17rem] font-semibold leading-none text-white/[0.04] lg:block" aria-hidden="true">1970</div>
      <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full border border-gold-light/20" aria-hidden="true"></div>
      <div class="relative max-w-3xl" data-reveal>
        <p class="mb-3 font-body text-xs font-bold uppercase tracking-[0.18em] text-gold-light sm:text-sm">Mari rencanakan bersama</p>
        <h2 class="font-display text-3xl font-semibold leading-tight tracking-tight sm:text-4xl lg:text-5xl">
          Acara yang hangat, dimulai dari hidangan yang dibuat sepenuh hati.
        </h2>
        <p class="mt-4 max-w-2xl text-sm leading-7 text-cream/75 sm:text-base sm:leading-8">
          Ceritakan kebutuhan keluarga atau kegiatan Anda. Tim Mak Yo siap membantu memilih paket yang sesuai.
        </p>
      </div>
      <div class="relative" data-reveal>
        <Button
          href={waLink('Halo, saya ingin merencanakan katering bersama Catering Mak Yo.')}
          target="_blank"
          rel="noopener noreferrer"
          data-wa-chooser
          data-wa-message="Halo, saya ingin merencanakan katering bersama Catering Mak Yo."
          class="w-full !bg-cream !text-terracotta-deep shadow-soft-lg hover:!bg-gold-light sm:w-auto"
        >
          <Icon name="whatsapp" class="h-5 w-5" />
          Hubungi Mak Yo
        </Button>
      </div>
    </div>
  </Container>
</section>
