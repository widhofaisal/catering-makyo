---
/**
 * Hand-illustrated vintage cameo silhouette — the brand's visual identity,
 * inspired by the founder's pose (hair in a low bun, gentle profile).
 * No source photo is embedded; this is an original SVG illustration.
 */
interface Props {
  size?: number;
  showRibbon?: boolean;
  class?: string;
}

const { size = 400, showRibbon = true, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 400 400"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Ilustrasi siluet Mak Yo, pendiri Catering Mak Yo"
  class={className}
>
  <defs>
    <linearGradient id="cameo-ring" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="var(--color-gold-light)" />
      <stop offset="100%" stop-color="var(--color-gold-deep)" />
    </linearGradient>
  </defs>

  <circle cx="200" cy="200" r="188" fill="none" stroke="url(#cameo-ring)" stroke-width="4" />
  <circle
    cx="200"
    cy="200"
    r="176"
    fill="none"
    stroke="var(--color-gold)"
    stroke-width="1.5"
    stroke-dasharray="1 7"
    stroke-linecap="round"
  />

  <circle cx="200" cy="200" r="165" fill="var(--color-green-deep)" />
  <circle cx="200" cy="200" r="165" fill="none" stroke="var(--color-gold-light)" stroke-width="2" />

  <path
    fill="var(--color-cream-dark)"
    d="
      M 160,90
      Q 210,95 220,135
      Q 224,150 250,170
      Q 228,182 226,192
      Q 218,208 202,218
      Q 190,228 186,246
      Q 184,264 200,276
      Q 250,288 300,310
      L 300,335
      L 96,335
      L 96,285
      Q 98,266 116,256
      Q 130,246 130,224
      Q 96,214 92,176
      Q 90,148 108,128
      Q 100,108 122,96
      Q 140,88 160,90
      Z"
  />
  <ellipse cx="112" cy="238" rx="22" ry="18" fill="var(--color-cream-dark)" />
  <circle cx="196" cy="222" r="3.5" fill="var(--color-gold-light)" />
  <path
    fill="none"
    stroke="var(--color-gold-deep)"
    stroke-width="1.5"
    opacity="0.55"
    d="M 96,300 Q 130,318 165,322 Q 220,326 270,318"
  />

  {
    showRibbon && (
      <g>
        <path d="M 90,340 L 200,362 L 310,340 L 310,318 L 200,338 L 90,318 Z" fill="var(--color-gold-deep)" />
        <text
          x="200"
          y="352"
          text-anchor="middle"
          font-family="var(--font-display)"
          font-size="22"
          fill="var(--color-cream)"
          letter-spacing="2"
        >
          EST. 1970
        </text>
      </g>
    )
  }
</svg>
