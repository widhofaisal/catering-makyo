---
/**
 * Vintage gold cameo frame — the brand's visual identity. By default renders
 * an original hand-illustrated silhouette (nav/footer brand mark). Pass
 * `photoSrc` to frame a real photo inside the same cameo instead (used in
 * the Hero for Mak Yo's actual portrait).
 */
interface Props {
  size?: number;
  showRibbon?: boolean;
  photoSrc?: string;
  photoAlt?: string;
  class?: string;
}

const { size = 400, showRibbon = true, photoSrc, photoAlt, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 400 400"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={photoSrc ? photoAlt ?? 'Foto Mak Yo, pendiri Catering Mak Yo' : 'Ilustrasi siluet Mak Yo, pendiri Catering Mak Yo'}
  class={className}
>
  <defs>
    <linearGradient id="cameo-ring" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="var(--color-gold-light)" />
      <stop offset="100%" stop-color="var(--color-gold-deep)" />
    </linearGradient>
    <clipPath id="cameo-clip">
      <circle cx="200" cy="200" r="170" />
    </clipPath>
  </defs>

  <circle cx="200" cy="200" r="182" fill="none" stroke="url(#cameo-ring)" stroke-width="3" />

  {
    photoSrc ? (
      <image
        href={photoSrc}
        x="30"
        y="30"
        width="340"
        height="340"
        preserveAspectRatio="xMidYMid slice"
        clip-path="url(#cameo-clip)"
      />
    ) : (
      <>
        <circle cx="200" cy="200" r="170" fill="var(--color-terracotta-deep)" />
        <path
          fill="var(--color-cream-dark)"
          d="
            M 160,90
            Q 210,95 220,135
            Q 224,150 250,170
            Q 228,182 226,192
            Q 218,208 202,218
            Q 190,228 186,246
            Q 184,264 200,276
            Q 250,288 300,310
            L 300,335
            L 96,335
            L 96,285
            Q 98,266 116,256
            Q 130,246 130,224
            Q 96,214 92,176
            Q 90,148 108,128
            Q 100,108 122,96
            Q 140,88 160,90
            Z"
        />
        <ellipse cx="112" cy="238" rx="22" ry="18" fill="var(--color-cream-dark)" />
        <circle cx="196" cy="222" r="3.5" fill="var(--color-gold-light)" />
        <path
          fill="none"
          stroke="var(--color-gold-deep)"
          stroke-width="1.5"
          opacity="0.55"
          d="M 96,300 Q 130,318 165,322 Q 220,326 270,318"
        />
      </>
    )
  }

  <circle cx="200" cy="200" r="170" fill="none" stroke="var(--color-gold-light)" stroke-width="2" />

  {
    showRibbon && (
      <g>
        <circle cx="316" cy="308" r="42" fill="var(--color-gold-deep)" stroke="var(--color-cream)" stroke-width="4" />
        <text
          x="316"
          y="303"
          text-anchor="middle"
          font-family="var(--font-display)"
          font-size="12"
          fill="var(--color-cream)"
          letter-spacing="1.5"
        >
          EST.
        </text>
        <text
          x="316"
          y="321"
          text-anchor="middle"
          font-family="var(--font-display)"
          font-size="16"
          font-weight="600"
          fill="var(--color-cream)"
          letter-spacing="0.5"
        >
          1970
        </text>
      </g>
    )
  }
</svg>
