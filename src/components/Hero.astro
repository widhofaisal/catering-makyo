---
import Container from './ui/Container.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import GrandmaPortrait from './GrandmaPortrait.astro';
import { company, waLink } from '../data/company';
---

<section id="home" class="relative overflow-hidden bg-cream pt-32 pb-24 sm:pt-40 sm:pb-32">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,var(--color-gold-light),transparent_55%)] opacity-40" aria-hidden="true"></div>

  <Container class="relative grid items-center gap-16 lg:grid-cols-2">
    <div class="text-center lg:text-left">
      <p class="load-fade-up mb-4 font-body text-sm font-semibold uppercase tracking-[0.25em] text-gold-deep" style="animation-delay:0ms">
        Warisan Keluarga Sejak 1970
      </p>
      <h1 class="load-fade-up font-display text-5xl font-semibold leading-tight text-ink sm:text-6xl lg:text-7xl" style="animation-delay:80ms">
        Catering Mak Yo
      </h1>
      <p class="load-fade-up mt-5 font-display text-2xl text-terracotta-deep sm:text-3xl" style="animation-delay:160ms">
        {company.tagline}
      </p>
      <p class="load-fade-up mx-auto mt-6 max-w-xl text-lg leading-relaxed text-ink-soft lg:mx-0" style="animation-delay:240ms">
        {company.description}
      </p>

      <div class="load-fade-up mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center lg:justify-start" style="animation-delay:320ms">
        <Button href={waLink('Halo, saya ingin memesan Catering Mak Yo.')} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" class="h-5 w-5" />
          Pesan Sekarang
        </Button>
        <Button href="#menu" variant="secondary">
          Lihat Menu
        </Button>
      </div>

      <div class="load-fade-up mt-10 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-ink-soft lg:justify-start" style="animation-delay:400ms">
        <span class="flex items-center gap-2">
          <Icon name="star" class="h-4 w-4 text-gold" />
          <strong class="text-ink">{company.rating.value.toFixed(1)}</strong> rating di {company.rating.source}
        </span>
        {
          company.womenOwned && (
            <span class="flex items-center gap-2">
              <Icon name="award" class="h-4 w-4 text-gold" />
              Usaha milik perempuan
            </span>
          )
        }
      </div>
    </div>

    <div class="relative mx-auto flex justify-center">
      <div class="load-fade-up" style="animation-delay:200ms">
        <GrandmaPortrait
          size={380}
          photoSrc="/images/hero/nenek.jpg"
          photoAlt="Foto Mak Yo, pendiri Catering Mak Yo sejak 1970"
          class="h-auto w-[280px] drop-shadow-2xl sm:w-[380px]"
        />
      </div>
    </div>
  </Container>
</section>
