---
import StarRating from './ui/StarRating.astro';
import type { Testimonial } from '../data/testimonials';

interface Props {
  testimonial: Testimonial;
  style?: string;
}

const { testimonial, style } = Astro.props;
const initial = testimonial.name.charAt(0).toUpperCase();
---

<figure
  class="flex h-full flex-col rounded-3xl border border-ink/5 bg-white p-8 shadow-soft"
  data-reveal
  style={style}
>
  <StarRating rating={testimonial.rating} class="mb-4" />
  <blockquote class="flex-1 text-ink-soft leading-relaxed">
    &ldquo;{testimonial.quote}&rdquo;
  </blockquote>
  <figcaption class="mt-6 flex items-center gap-3 border-t border-ink/5 pt-5">
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-green-light font-display text-lg font-semibold text-green-deep">
      {initial}
    </span>
    <div>
      <p class="font-semibold text-ink">{testimonial.name}</p>
      <p class="text-sm text-ink-soft">{testimonial.eventType} &middot; {testimonial.date}</p>
    </div>
  </figcaption>
</figure>
