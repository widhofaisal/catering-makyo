---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  tone?: 'light' | 'dark';
  class?: string;
}

const { eyebrow, title, subtitle, align = 'center', tone = 'light', class: className = '' } = Astro.props;
const isCentered = align === 'center';
const isDark = tone === 'dark';
---

<div
  class:list={[
    'max-w-2xl',
    isCentered ? 'mx-auto text-center' : 'text-left',
    className,
  ]}
  data-reveal
>
  {
    eyebrow && (
      <p class:list={['mb-3 font-body text-xs font-bold uppercase tracking-[0.18em] sm:text-sm', isDark ? 'text-gold-light' : 'text-terracotta-deep']}>
        {eyebrow}
      </p>
    )
  }
  <h2 class:list={['font-display text-3xl font-semibold leading-tight tracking-tight sm:text-4xl', isDark ? 'text-cream' : 'text-ink']}>{title}</h2>
  {subtitle && <p class:list={['mt-4 text-base leading-7 sm:text-lg sm:leading-8', isDark ? 'text-cream/70' : 'text-ink-soft']}>{subtitle}</p>}
</div>
