---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  class?: string;
}

const { eyebrow, title, subtitle, align = 'center', class: className = '' } = Astro.props;
const isCentered = align === 'center';
---

<div
  class:list={[
    'max-w-2xl',
    isCentered ? 'mx-auto text-center' : 'text-left',
    className,
  ]}
  data-reveal
>
  {
    eyebrow && (
      <p class="mb-3 font-body text-sm font-semibold uppercase tracking-[0.2em] text-gold-deep">
        {eyebrow}
      </p>
    )
  }
  <h2 class="text-3xl font-semibold text-ink sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-lg leading-relaxed text-ink-soft">{subtitle}</p>}
</div>
