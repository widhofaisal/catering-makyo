---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  icon: IconName;
  title: string;
  description: string;
  style?: string;
  inverse?: boolean;
}

const { icon, title, description, style, inverse = false } = Astro.props;
---

<div
  class:list={[
    'group border-t py-7 transition-colors duration-300 sm:py-8',
    inverse ? 'border-gold-light/35 hover:border-gold-light' : 'border-gold/50 hover:border-terracotta',
  ]}
  data-reveal
  style={style}
>
  <div class:list={[
    'mb-5 flex h-11 w-11 items-center justify-center rounded-full transition-colors duration-300',
    inverse ? 'bg-cream/10 text-gold-light group-hover:bg-gold-light group-hover:text-terracotta-deep' : 'bg-white text-terracotta-deep group-hover:bg-terracotta group-hover:text-white',
  ]}>
    <Icon name={icon} class="h-5 w-5" />
  </div>
  <h3 class:list={['font-display text-xl font-semibold', inverse ? 'text-cream' : 'text-ink']}>{title}</h3>
  <p class:list={['mt-2 text-sm leading-6', inverse ? 'text-cream/70' : 'text-ink-soft']}>{description}</p>
</div>
