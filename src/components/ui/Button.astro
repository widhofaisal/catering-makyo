---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
  target?: string;
  rel?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  class: className = '',
  target,
  rel,
  'aria-label': ariaLabel,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-2xl px-7 py-3.5 font-body text-base font-semibold transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2';

const variants = {
  primary:
    'bg-terracotta text-white shadow-soft hover:bg-terracotta-deep hover:shadow-soft-lg hover:-translate-y-0.5',
  secondary:
    'bg-white text-ink border border-ink/15 shadow-soft hover:border-gold-deep hover:text-gold-deep hover:-translate-y-0.5',
  ghost: 'text-ink hover:text-gold-deep',
};

const classes = [base, variants[variant], className].join(' ');
const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} target={target} rel={rel} aria-label={ariaLabel}>
  <slot />
</Tag>
