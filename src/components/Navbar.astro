---
import Container from './ui/Container.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import BrandMark from './BrandMark.astro';
import { waLink } from '../data/company';

const navLinks = [
  { href: '#home', label: 'Beranda' },
  { href: '#about', label: 'Kisah Mak Yo' },
  { href: '#menu', label: 'Layanan' },
  { href: '#gallery', label: 'Galeri' },
  { href: '#testimonials', label: 'Ulasan' },
  { href: '#contact', label: 'Kontak' },
];
---

<header
  data-navbar
  class="fixed inset-x-0 top-0 z-50 border-b border-cream/10 bg-terracotta-deep/95 text-cream shadow-soft transition-all duration-300 [&.is-scrolled]:border-ink/10 [&.is-scrolled]:bg-cream/95 [&.is-scrolled]:shadow-soft [&.is-scrolled]:backdrop-blur-lg"
>
  <Container>
    <nav class="flex items-center justify-between py-4" aria-label="Navigasi utama">
      <a href="#home" data-nav-brand class="flex items-center gap-3 font-display text-base font-semibold text-cream sm:text-lg">
        <BrandMark size={40} class="shrink-0" />
        <span>Catering Mak Yo</span>
      </a>

      <ul class="hidden items-center gap-6 lg:flex xl:gap-8">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-link
                class="font-body text-sm font-semibold text-cream/80 transition-colors hover:text-gold-light"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="hidden lg:block">
        <Button href={waLink('Halo, saya ingin memesan Catering Mak Yo.')} target="_blank" rel="noopener noreferrer" class="border border-terracotta/15 !bg-cream !py-2.5 !px-5 !text-sm !text-terracotta-deep shadow-soft hover:!bg-gold-light">
          Pesan Sekarang
        </Button>
      </div>

      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label="Buka menu navigasi"
        class="group flex h-11 w-11 items-center justify-center rounded-xl border border-cream/25 text-cream transition-colors lg:hidden"
      >
        <Icon name="menu" class="h-5 w-5 group-aria-expanded:hidden" />
        <Icon name="close" class="hidden h-5 w-5 group-aria-expanded:block" />
      </button>
    </nav>
  </Container>

  <div
    id="mobile-nav-panel"
    data-nav-panel
    class="max-h-0 overflow-hidden bg-terracotta-deep transition-[max-height] duration-300 [&.is-open]:max-h-[30rem] lg:hidden"
  >
    <Container>
      <ul class="flex flex-col gap-1 py-4">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-mobile-link
                class="block rounded-xl px-3 py-3 font-body text-base font-medium text-cream/85 transition-colors hover:bg-white/10 hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="pt-2">
          <Button
            href={waLink('Halo, saya ingin memesan Catering Mak Yo.')}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full"
          >
            Pesan Sekarang
          </Button>
        </li>
      </ul>
    </Container>
  </div>
</header>

<script src="../scripts/navbar.ts"></script>
