---
import Container from './ui/Container.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import GrandmaPortrait from './GrandmaPortrait.astro';
import { waLink } from '../data/company';

const navLinks = [
  { href: '#home', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#menu', label: 'Menu' },
  { href: '#gallery', label: 'Gallery' },
  { href: '#testimonials', label: 'Testimonials' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  data-navbar
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-all duration-300 [&.is-scrolled]:border-ink/5 [&.is-scrolled]:bg-white/80 [&.is-scrolled]:shadow-soft [&.is-scrolled]:backdrop-blur-lg"
>
  <Container>
    <nav class="flex items-center justify-between py-4" aria-label="Navigasi utama">
      <a href="#home" class="flex items-center gap-3 font-display text-lg font-semibold text-ink">
        <GrandmaPortrait size={40} showRibbon={false} class="shrink-0" />
        <span>Catering Mak Yo</span>
      </a>

      <ul class="hidden items-center gap-8 md:flex">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-body text-sm font-medium text-ink-soft transition-colors hover:text-gold-deep"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="hidden md:block">
        <Button href={waLink('Halo, saya ingin memesan Catering Mak Yo.')} target="_blank" rel="noopener noreferrer" class="!py-2.5 !px-5 text-sm">
          Pesan Sekarang
        </Button>
      </div>

      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label="Buka menu navigasi"
        class="group flex h-11 w-11 items-center justify-center rounded-xl border border-ink/10 text-ink md:hidden"
      >
        <Icon name="menu" class="h-5 w-5 group-aria-expanded:hidden" />
        <Icon name="close" class="hidden h-5 w-5 group-aria-expanded:block" />
      </button>
    </nav>
  </Container>

  <div
    id="mobile-nav-panel"
    data-nav-panel
    class="max-h-0 overflow-hidden bg-white/95 backdrop-blur-lg transition-[max-height] duration-300 [&.is-open]:max-h-96 md:hidden"
  >
    <Container>
      <ul class="flex flex-col gap-1 py-4">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-xl px-3 py-3 font-body text-base font-medium text-ink transition-colors hover:bg-cream hover:text-gold-deep"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="pt-2">
          <Button
            href={waLink('Halo, saya ingin memesan Catering Mak Yo.')}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full"
          >
            Pesan Sekarang
          </Button>
        </li>
      </ul>
    </Container>
  </div>
</header>

<script src="../scripts/navbar.ts"></script>
