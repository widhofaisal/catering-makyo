---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<span
  role="img"
  aria-label="Potret nenek Catering Mak Yo"
  class={`inline-flex shrink-0 rounded-full border border-gold-light bg-terracotta-deep p-[3px] ${className}`}
  style={`width:${size}px;height:${size}px`}
>
  <img
    src="/images/hero/nenek.jpg"
    alt=""
    width="1254"
    height="1254"
    loading="eager"
    decoding="async"
    class="h-full w-full rounded-full object-cover object-[50%_38%]"
  />
</span>
