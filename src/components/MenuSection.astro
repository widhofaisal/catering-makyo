---
import Container from './ui/Container.astro';
import SectionHeading from './ui/SectionHeading.astro';
import MenuCard from './MenuCard.astro';
import { menuCategories } from '../data/menu';
---

<section id="menu" class="bg-white py-24 sm:py-32">
  <Container>
    <SectionHeading
      eyebrow="Paket Layanan"
      title="Menu & Paket Katering"
      subtitle="Dari acara harian hingga momen besar keluarga, Catering Mak Yo siap menghadirkan cita rasa rumahan untuk setiap kebutuhan."
    />

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {menuCategories.map((item, index) => <MenuCard item={item} index={index} />)}
    </div>
  </Container>
</section>
