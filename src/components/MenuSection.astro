---
import Container from './ui/Container.astro';
import MenuCard from './MenuCard.astro';
import { menuCategories } from '../data/menu';
---

<section id="menu" class="bg-cream py-20 sm:py-28">
  <Container>
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end lg:gap-12">
      <div class="max-w-3xl">
        <p class="mb-3 font-body text-xs font-bold uppercase tracking-[0.18em] text-terracotta-deep sm:text-sm">Layanan Catering Mak Yo</p>
        <h2 class="font-display text-4xl font-semibold leading-[1.03] tracking-tight text-ink sm:text-5xl lg:text-6xl">
          Dari acara keluarga <span class="italic text-terracotta">hingga perkemahan.</span>
        </h2>
      </div>
      <p class="max-w-md text-base leading-7 text-ink-soft sm:text-lg sm:leading-8">
        Pilih layanan yang Anda perlukan. Ceritakan acaranya kepada kami untuk menyesuaikan hidangan dan paketnya.
      </p>
    </div>

    {menuCategories[0] && <div class="mt-12 lg:mt-16"><MenuCard item={menuCategories[0]} index={0} featured /></div>}

    <div class="mt-12 grid gap-x-7 gap-y-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-y-14">
      {menuCategories.slice(1).map((item, index) => <MenuCard item={item} index={index + 1} />)}
    </div>
  </Container>
</section>
