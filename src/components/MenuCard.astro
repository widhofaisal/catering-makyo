---
import Icon from './ui/Icon.astro';
import { waLink } from '../data/company';
import type { MenuCategory } from '../data/menu';

interface Props {
  item: MenuCategory;
  index: number;
}

const { item, index } = Astro.props;
const message = `Halo, saya ingin tanya-tanya soal paket ${item.title} dari Catering Mak Yo.`;
---

<article
  class="group overflow-hidden rounded-3xl border border-ink/5 bg-white shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-soft-lg"
  data-reveal
  style={`animation-delay:${(index % 4) * 80}ms`}
>
  <div class="aspect-[4/3] overflow-hidden">
    <img
      src={item.image}
      alt={item.imageAlt}
      width="800"
      height="600"
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <div class="p-6">
    <h3 class="text-xl font-semibold text-ink">{item.title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.description}</p>
    <a
      href={waLink(message)}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-5 inline-flex items-center gap-2 font-body text-sm font-semibold text-gold-deep transition-colors hover:text-terracotta-deep"
    >
      Tanya via WhatsApp
      <Icon name="whatsapp" class="h-4 w-4" />
    </a>
  </div>
</article>
