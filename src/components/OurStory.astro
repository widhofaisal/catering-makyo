---
import Container from './ui/Container.astro';
import BrandMark from './BrandMark.astro';
import { timeline } from '../data/company';
---

<section id="about" class="overflow-hidden bg-cream-dark py-20 sm:py-28">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:gap-20">
      <div class="relative lg:sticky lg:top-32 lg:self-start" data-reveal>
        <p class="mb-3 font-body text-xs font-bold uppercase tracking-[0.18em] text-terracotta-deep sm:text-sm">Kisah keluarga Mak Yo</p>
        <h2 class="max-w-xl font-display text-4xl font-semibold leading-[1.03] tracking-tight text-ink sm:text-5xl lg:text-6xl">
          Dapur kecil,<br />
          <span class="italic text-terracotta">cerita yang terus tumbuh.</span>
        </h2>
        <p class="mt-5 max-w-md text-base leading-7 text-ink-soft sm:text-lg sm:leading-8">
          Berawal dari Gunungpati, masakan Mak Yo tumbuh bersama keluarga dan kegiatan yang mempertemukan banyak orang.
        </p>
        <div class="mt-8 flex items-center gap-4 border-t border-terracotta/20 pt-6">
          <BrandMark size={72} class="h-[4.5rem] w-[4.5rem] shrink-0" />
          <div>
            <p class="font-display text-xl font-semibold text-ink">Warisan sejak 1970</p>
            <p class="mt-1 text-sm text-ink-soft">Diteruskan dengan rasa yang sama</p>
          </div>
        </div>
      </div>

      <ol class="relative space-y-0 border-l border-terracotta/25 pl-6 sm:pl-9">
        {
          timeline.map((event, i) => (
            <li class="relative grid gap-2 border-b border-terracotta/15 py-6 first:pt-0 last:border-0 sm:gap-4 sm:py-8 lg:grid-cols-[8rem_1fr] lg:gap-7" data-reveal style={`animation-delay:${i * 90}ms`}>
              <span class="absolute -left-[1.92rem] top-7 flex h-3 w-3 items-center justify-center rounded-full border-[3px] border-cream-dark bg-terracotta sm:-left-[2.44rem] sm:top-9" aria-hidden="true"></span>
              <p class="font-display text-2xl font-semibold leading-none text-terracotta sm:text-3xl">{event.year}</p>
              <div>
                <h3 class="font-display text-xl font-semibold text-ink sm:text-2xl">{event.title}</h3>
                <p class="mt-2 max-w-xl text-sm leading-6 text-ink-soft sm:text-base sm:leading-7">{event.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Container>
</section>
