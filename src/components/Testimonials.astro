---
import Container from './ui/Container.astro';
import SectionHeading from './ui/SectionHeading.astro';
import TestimonialCard from './TestimonialCard.astro';
import { testimonials } from '../data/testimonials';
---

<section id="testimonials" class="bg-white py-24 sm:py-32">
  <Container>
    <SectionHeading
      eyebrow="Testimoni"
      title="Apa Kata Mereka"
      subtitle="Kepercayaan pelanggan adalah warisan yang paling berharga bagi kami."
    />

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        testimonials.map((testimonial, i) => (
          <TestimonialCard testimonial={testimonial} style={`animation-delay:${(i % 3) * 100}ms`} />
        ))
      }
    </div>
  </Container>
</section>
