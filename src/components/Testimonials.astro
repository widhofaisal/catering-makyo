---
import Container from './ui/Container.astro';
import Icon from './ui/Icon.astro';
import { company } from '../data/company';
---

<section id="testimonials" class="overflow-hidden bg-gold-light/35 py-20 sm:py-28">
  <Container>
    <div class="relative grid overflow-hidden rounded-[2rem] bg-cream shadow-soft-lg sm:rounded-[2.5rem] lg:grid-cols-[0.85fr_1.15fr]">
      <div class="relative flex min-h-64 flex-col justify-center overflow-hidden bg-terracotta-deep px-7 py-9 text-cream sm:px-10 sm:py-12 lg:px-14 lg:py-14">
        <div class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full border border-gold-light/25" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -right-8 -top-12 h-48 w-48 rounded-full border border-gold-light/15" aria-hidden="true"></div>
        <p class="relative font-body text-xs font-bold uppercase tracking-[0.18em] text-gold-light">Rating Google Maps</p>
        <div class="relative mt-3 flex items-end gap-4">
          <p class="font-display text-7xl font-semibold leading-none tracking-tight text-cream sm:text-8xl">{company.rating.value.toFixed(1)}</p>
          <div class="pb-2">
            <div class="flex gap-1 text-gold-light" role="img" aria-label="Bintang lima">
              {Array.from({ length: 5 }).map(() => <Icon name="star" class="h-4 w-4 sm:h-5 sm:w-5" />)}
            </div>
            <p class="mt-1 text-xs text-cream/70">dari pelanggan Mak Yo</p>
          </div>
        </div>
      </div>

      <div class="flex flex-col items-start justify-center px-7 py-9 sm:px-10 sm:py-12 lg:px-14 lg:py-14">
        <p class="font-body text-xs font-bold uppercase tracking-[0.18em] text-terracotta-deep sm:text-sm">Ulasan pelanggan</p>
        <h2 class="mt-3 max-w-xl font-display text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl lg:text-5xl">
          Kepercayaan yang terasa di setiap acara.
        </h2>
        <p class="mt-4 max-w-lg text-sm leading-7 text-ink-soft sm:text-base sm:leading-8">
          Baca pengalaman pelanggan langsung di Google Maps dan lihat mengapa Mak Yo terus dipercaya untuk momen kebersamaan.
        </p>
        <a
          href={company.mapsShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex min-h-12 items-center justify-center gap-3 rounded-xl bg-ink px-5 py-3 text-sm font-semibold text-cream transition-colors hover:bg-terracotta-deep focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-deep"
        >
          Lihat ulasan pelanggan
          <span aria-hidden="true">↗</span>
          <span class="sr-only"> (membuka Google Maps di tab baru)</span>
        </a>
      </div>
    </div>
  </Container>
</section>
